######### Generated by Lwspanel #########
######### Ne pas modifier / Don't touch #########

# Redirections https yewtod.com
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !on
RewriteCond %{HTTP_HOST} ^(?:www\.)?yewtod\.com(?:.*)$ [nc]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [redirect=301,L]

######### End Generated by Lwspanel #########

# =====================================================================
# Yewtod SS — .htaccess RACINE pour la formule LWS Perso (décision D73)
#
# Sur cette formule, la racine web est /htdocs et ne peut pas être changée :
# tout le projet Laravel s'y trouve, .env compris. Ce fichier fait en sorte
# que SEUL le dossier public/ soit joignable depuis le web. Trois couches :
#   1. toute requête est réécrite vers public/ (rien d'autre n'est servi) ;
#   2. les noms sensibles sont refusés même si la réécriture ne s'appliquait
#      pas (module absent, .htaccess d'un sous-dossier) ;
#   3. le paquet de déploiement ajoute un « Require all denied » dans chaque
#      dossier de premier niveau autre que public/ (scripts/preparer-paquet.sh).
# Avec une racine web sur public/ (formule Starter et plus), ce fichier
# n'est pas lu. Le bloc LWS en tête est géré par le panneau (« forcer HTTPS ») :
# s'il change dans le panneau, recopiez la nouvelle version ici (D76).
# =====================================================================

Options -Indexes -MultiViews

# --- Couche 2 : noms sensibles refusés à la racine et dans tous les sous-dossiers.
<FilesMatch "^\.|^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon|pint\.json|vite\.config\.js|README\.md)$|\.(env|sql|ybk|log|sh|md|neon|lock|bak|zip|tar|gz)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS : assuré par le bloc « Generated by Lwspanel » ci-dessus (option du panneau,
    # recopié tel quel pour que le panneau le retrouve). Ici : domaine sans « www »
    # (APP_URL n'accepte qu'un seul hôte), toujours vers https.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Fichiers cachés (.env, .git…) : 403 avant toute autre règle.
    RewriteRule (^|/)\. - [F,L]

    # --- Couche 1 : tout part vers public/ (qui a son propre .htaccess).
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sans mod_rewrite, le site ne peut pas fonctionner : on refuse tout plutôt
# que d'exposer les fichiers du projet.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
