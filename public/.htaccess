# Yewtod SS — configuration Apache (LWS mutualisé, racine web = public/).

# Jamais de listage de dossiers (cahier § 8.4), même hors mod_rewrite.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers cachés (.env, .git…) : jamais servis, même s'ils arrivaient dans public/.
    RewriteRule (^|/)\. - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    # « /public » est retiré s'il a été ajouté par le .htaccess racine (LWS Perso, D73).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(?:/public(?=/))?(.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Fichiers envoyés (storage/app/public) : jamais exécutés comme du PHP ni interprétés.
<IfModule mod_headers.c>
    # Aussi pour les fichiers statiques servis directement par Apache (constat ZAP).
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cross-Origin-Resource-Policy "same-site"
    # Assets compilés par Vite : noms avec empreinte, cache long et immuable (performance).
    # « (/public)? » : sur LWS Perso, le .htaccess racine réécrit l'adresse vers public/ (D73).
    <If "%{REQUEST_URI} =~ m#^(/public)?/build/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^(/public)?/storage/#">
        Header set Cache-Control "public, max-age=604800"
    </If>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml application/rss+xml text/plain
</IfModule>
