# =====================================================================
# Yewtod SS — variables d'environnement
# Ce fichier ne contient QUE des noms de variables et des valeurs non
# secrètes. Copiez-le en .env (chmod 600) puis renseignez les secrets.
# =====================================================================

APP_NAME="Yewtod SS"
APP_ENV=local
APP_KEY=
# Jamais true en préproduction ni en production (cahier § 8.4).
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
# Anciennes clés acceptées en lecture après une rotation d'APP_KEY.
APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Base de données (MariaDB, même version majeure que LWS) -------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yewtod
# Compte applicatif : CRUD uniquement en local ; utilisateur unique chez LWS.
DB_USERNAME=yewtod_app
DB_PASSWORD=
# Compte de migration (local). Laisser VIDE chez LWS : on retombe alors sur
# l'utilisateur unique (voir docs/SECURITE.md).
DB_MIGRATE_USERNAME=
DB_MIGRATE_PASSWORD=

# --- Sessions (cahier § 8.3) -------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true en préproduction et production (HTTPS obligatoire).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Pas de worker permanent sur le mutualisé : file « database » traitée par le cron.
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Emails (SMTP de l'hébergeur ou service transactionnel) -------------
# Sans SMTP, MAIL_MAILER=log : les emails sont écrits dans storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yewtod.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Services tiers (décision 8 : facultatifs, désactivation propre) ----
# Analyse IA des PDF.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Synchronisation newsletter (décision 9).
BREVO_API_KEY=
BREVO_LIST_ID=
# Anti-spam des formulaires publics. Clés de test Cloudflare possibles en local :
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vérification des mots de passe compromis (Have I Been Pwned).
HIBP_ENABLED=true

# --- Sauvegardes (cahier § 8.6) ----------------------------------------
# Phrase de passe de chiffrement des sauvegardes (openssl rand -base64 48).
# À conserver HORS du serveur avec APP_KEY.
# 16 caractères minimum, DISTINCTE d'APP_KEY, conservée hors du serveur.
BACKUP_PASSPHRASE=
BACKUP_PATH=

VITE_APP_NAME="${APP_NAME}"

# Proxys de confiance (vide = aucun ; ne jamais mettre *)
TRUSTED_PROXIES=

# --- Mentions légales (obligatoires avant la mise en ligne) --------------
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_CONTACT_EMAIL=
# Coordonnées de l'hébergeur (valeur par défaut : LWS, à revérifier).
LEGAL_HOST=

# --- Préproduction protégée (laisser VIDE en production) -----------------
# Mot de passe haché : php -r 'echo password_hash("…", PASSWORD_ARGON2ID), PHP_EOL;'
# (mettre la valeur entre guillemets simples : elle contient des « $ »)
PREPROD_USER=
PREPROD_PASSWORD_HASH=
