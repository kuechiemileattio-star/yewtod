# Copier en scripts/deploiement.env (ignoré par Git) et remplir.
# Une section par environnement : préfixe PREPROD_ ou PROD_.

# Hôte SSH LWS (voir l'espace client : « Accès SSH »).
PREPROD_SSH="utilisateur@ssh.cluster0XX.lws.fr"
PREPROD_PORT=22
# Dossier de l'application sur le serveur (la racine web pointe sur $PREPROD_DIR/public).
PREPROD_DIR="/home/utilisateur/preprod.yewtod.com"
# Binaire PHP 8.3+ sur le serveur (vérifier avec : ssh … 'ls /usr/local/php*/bin/php; php -v').
PREPROD_PHP="php"
PREPROD_COMPOSER="composer"
PREPROD_URL="https://preprod.yewtod.com"

PROD_SSH="utilisateur@ssh.cluster0XX.lws.fr"
PROD_PORT=22
PROD_DIR="/home/utilisateur/yewtod.com"
PROD_PHP="php"
PROD_COMPOSER="composer"
PROD_URL="https://yewtod.com"
